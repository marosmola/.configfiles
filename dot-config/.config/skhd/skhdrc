ctrl + shift - r : yabai --load-config

# general
ctrl - e : LAYOUT=$(yabai -m query --spaces --space | jq -r '.type'); if [ "$LAYOUT" = "bsp" ]; then yabai -m space --layout float; else yabai -m space --layout bsp; fi; sketchybar --trigger yabai_focus_change
ctrl + shift - e : LAYOUT=$(yabai -m query --spaces | jq -r '.[0].type'); if [ "$LAYOUT" = "bsp" ]; then for i in $(seq 1 6); do yabai -m space $i --layout float; done; pkill borders; else for i in $(seq 1 6); do yabai -m space $i --layout bsp; done; borders active_color=0xffffffff inactive_color=0xff444444 width=4.0 & fi; sketchybar --trigger yabai_focus_change
ctrl - s : ~/.local/bin/yabai-stack-last
ctrl - b : yabai -m space --balance

# focus
ctrl - left : yabai -m window --focus west
ctrl - right : yabai -m window --focus east
ctrl - down : yabai -m window --focus stack.next || yabai -m window --focus south
ctrl - up : yabai -m window --focus stack.prev || yabai -m window --focus north


# move
ctrl + shift - left : yabai -m window --warp west
ctrl + shift - right : yabai -m window --warp east
ctrl + shift - down : yabai -m window --warp south
ctrl + shift - up : yabai -m window --warp north

ctrl + alt - left : yabai -m window --focus west || yabai -m window --focus north
ctrl + alt - right : yabai -m window --focus east || yabai -m window --focus south

cmd - 1 : yabai -m space --focus 1
cmd - 2 : yabai -m space --focus 2
cmd - 3 : yabai -m space --focus 3
cmd - 4 : yabai -m space --focus 4
cmd - 5 : yabai -m space --focus 5
cmd - 6 : yabai -m space --focus 6

ctrl + shift - 1 : yabai -m window --space 1
ctrl + shift - 2 : yabai -m window --space 2
ctrl + shift - 3 : yabai -m window --space 3
ctrl + shift - 4 : yabai -m window --space 4
ctrl + shift - 5 : yabai -m window --space 5
ctrl + shift - 6 : yabai -m window --space 6

ctrl - f : yabai -m window --toggle float && sketchybar --trigger yabai_focus_change
ctrl - t : yabai -m window --toggle split

cmd - return : open -na /Applications/Ghostty.app

cmd - tab : yabai -m window --focus recent



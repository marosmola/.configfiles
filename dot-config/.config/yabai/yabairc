yabai -m config debug_output on

yabai -m config top_padding    5
yabai -m config bottom_padding 40
yabai -m config left_padding   40
yabai -m config right_padding  40
yabai -m config window_gap     10

yabai -m config window_opacity         off


yabai -m config mouse_modifier ctrl
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize
yabai -m config mouse_drop_action stack



# update sketchybar on window focus
yabai -m signal --add event=window_focused action="sketchybar --trigger yabai_focus_change"

# remember last focused tiled window for quick stacking
yabai -m signal --add event=window_focused action="$HOME/.local/bin/yabai-record-last-tiled"

# ensure spaces exist
yabai -m space --create
yabai -m space --create
yabai -m space --create
yabai -m space --create

# layouts
yabai -m config layout bsp

# labels
yabai -m space 1 --label "dev"
yabai -m space 2 --label "web"
yabai -m space 3 --label "chat"
yabai -m space 4 --label "personal"
yabai -m space 5 --label "scratch"
yabai -m space 6 --label "tmp"

# Ignore
yabai -m rule --add app='System Settings' manage=off
yabai -m rule --add app='Raycast' manage=off
